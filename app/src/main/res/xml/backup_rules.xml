<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude everything from legacy Auto Backup: local data holds integration credentials/tokens encrypted with an
     Android Keystore key that is NOT restored on a new device, so backed-up copies would be unreadable (and leak metadata). -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
