# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ---- SitePulse server (web/server) ----
# NODE_ENV=production
# AUTH_SECRET=            # REQUIRED in production, >= 32 random characters
# DATA_DIR=/var/lib/sitepulse
# ALLOWED_ORIGINS=        # comma-separated cross-origin allow-list (same-origin always allowed)
# TRUST_PROXY=1           # when behind a reverse proxy
# PLATFORM_ADMIN_EMAILS=  # comma-separated operator emails
# ENABLE_DEMO_SEED=1      # local dev only; refused in production
# DEMO_PASSWORD=
# ALLOW_SIMULATED_PAYMENTS=1  # local dev only; refused in production
